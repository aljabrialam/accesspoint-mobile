/**
 * Pre-generates natural guidance audio for every scripted line in scenario mode with edge-tts
 * (Microsoft Edge neural voices, no API key), so the app ships audio files.
 *
 *   python3 -m pip install edge-tts      once
 *   npm run voice:generate               generate missing clips
 *   npm run voice:generate -- --dry      list lines and voices only
 */
import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import { existsSync, mkdirSync, readdirSync, rmSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

import { scenarios } from '../src/scenario/scenarios';

const here = dirname(fileURLToPath(import.meta.url));
const ASSET_DIR = join(here, '..', 'assets', 'voice');
const MODULE_PATH = join(here, '..', 'src', 'voice', 'clips.generated.ts');
const PYTHON = process.env.PYTHON ?? 'python3';
/** Slightly slower than default: easier to follow for older users. */
const RATE = '-8%';
/** Edge voices pause ~1 s between sentences and trail silence; cap pauses at 0.3 s and trim the ends. */
const TIGHTEN = 'silenceremove=start_periods=1:start_threshold=-50dB:stop_periods=-1:stop_duration=0.3:stop_threshold=-50dB:stop_silence=0.3';
const VERSION = 'tight-v1';

/** Scenario voice tag -> edge-tts neural voice. */
const VOICES: Record<string, string> = {
  'en-SG': 'en-SG-LunaNeural',
  'en-GB': 'en-GB-SoniaNeural',
  'en-US': 'en-US-JennyNeural',
  'fil-PH': 'fil-PH-BlessicaNeural',
  'id-ID': 'id-ID-GadisNeural',
  'ms-MY': 'ms-MY-YasminNeural',
};

const dry = process.argv.includes('--dry');
const jobs = new Map<string, string>();
for (const s of scenarios) {
  const voice = VOICES[s.language] ?? VOICES['en-US'];
  for (const text of [...s.steps.map((st) => st.speech), s.result.title]) jobs.set(text, voice);
}
console.log(`${jobs.size} lines, voices: ${[...new Set(jobs.values())].join(', ')}`);
if (dry) process.exit(0);

try {
  execFileSync(PYTHON, ['-m', 'edge_tts', '--help'], { stdio: 'ignore' });
} catch {
  console.error(`edge-tts not found. Install it with: ${PYTHON} -m pip install edge-tts`);
  process.exit(1);
}

mkdirSync(ASSET_DIR, { recursive: true });
const entries: [string, string][] = [];
let generated = 0;
for (const [text, voice] of jobs) {
  const file = `${createHash('sha1').update(`${voice}|${RATE}|${VERSION}|${text}`).digest('hex').slice(0, 16)}.mp3`;
  entries.push([text, file]);
  const out = join(ASSET_DIR, file);
  if (existsSync(out)) continue;
  for (let attempt = 1; ; attempt++) {
    try {
      const raw = `${out}.raw.mp3`;
      execFileSync(PYTHON, ['-m', 'edge_tts', '--voice', voice, `--rate=${RATE}`, '--text', text, '--write-media', raw], { stdio: 'pipe' });
      execFileSync('ffmpeg', ['-loglevel', 'error', '-y', '-i', raw, '-af', TIGHTEN, '-c:a', 'libmp3lame', '-b:a', '64k', out], { stdio: 'pipe' });
      rmSync(raw, { force: true });
      break;
    } catch (error) {
      rmSync(out, { force: true });
      rmSync(`${out}.raw.mp3`, { force: true });
      const stderr = (error as { stderr?: Buffer }).stderr?.toString().trim().split('\n').pop() ?? String(error);
      if (attempt < 3) {
        console.warn(`  retry ${attempt} for "${text.slice(0, 40)}…": ${stderr.slice(0, 100)}`);
        continue;
      }
      console.error(`Failed on "${text.slice(0, 50)}…" (${voice}): ${stderr}`);
      process.exit(1);
    }
  }
  generated++;
  console.log(`  + ${file}  [${voice}] ${text.slice(0, 56)}`);
}

const keep = new Set(entries.map(([, f]) => f));
for (const f of readdirSync(ASSET_DIR)) if (!keep.has(f)) rmSync(join(ASSET_DIR, f));

writeFileSync(
  MODULE_PATH,
  `// Generated by scripts/generate-voice.mts. Do not edit by hand.\n` +
    `export const VOICE_INFO = ${JSON.stringify({ provider: 'edge-tts (Microsoft neural voices)', rate: RATE })};\n\n` +
    `export const VOICE_CLIPS: Record<string, number> = {\n` +
    entries.map(([text, file]) => `  ${JSON.stringify(text)}: require('../../assets/voice/${file}'),`).join('\n') +
    `\n};\n`,
);
console.log(`Done: ${generated} new, ${entries.length - generated} cached. Wrote ${MODULE_PATH}`);
